# Kopieer naar .env.local en vul in. Zie README.
# Alleen publieke waarden: alles met VITE_ komt in de JavaScript-bundel terecht.

# Project-URL uit Supabase → Project Settings → API
VITE_SUPABASE_URL=https://jouw-project-ref.supabase.co

# Publishable key (sb_publishable_...) of de oude anon key.
# NOOIT de secret/service role key hier zetten: de build-check faalt dan.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Minuten inactiviteit tot automatisch uitloggen
VITE_IDLE_TIMEOUT_MINUTES=15
